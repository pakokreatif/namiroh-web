---
import { getCollection } from 'astro:content';

const blogs = (await getCollection('blog')).slice(0, 3);
const produks = (await getCollection('produk')).filter(p => p.data.tersedia).slice(0, 6);
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>An Namiroh - Perjalanan Umroh & Haji</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', sans-serif; color: #1a1a1a; }
    header { background: #1a3a2a; color: white; padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    header h1 { font-size: 1.5rem; }
    nav a { color: #cde; text-decoration: none; margin-left: 1.5rem; }
    nav a:hover { color: white; }
    .hero { background: linear-gradient(135deg, #1a3a2a, #2d6a4f); color: white; padding: 5rem 2rem; text-align: center; }
    .hero h2 { font-size: 2.5rem; margin-bottom: 1rem; }
    .hero p { font-size: 1.2rem; opacity: 0.9; margin-bottom: 2rem; }
    .btn { background: #f4a261; color: white; padding: 0.75rem 2rem; border-radius: 8px; text-decoration: none; font-weight: bold; }
    .section { padding: 4rem 2rem; max-width: 1100px; margin: 0 auto; }
    .section h2 { font-size: 1.8rem; margin-bottom: 2rem; color: #1a3a2a; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
    .card { border: 1px solid #e0e0e0; border-radius: 12px; overflow: hidden; transition: box-shadow 0.2s; }
    .card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
    .card-body { padding: 1.25rem; }
    .card-body h3 { margin-bottom: 0.5rem; color: #1a3a2a; }
    .card-body p { color: #555; font-size: 0.9rem; line-height: 1.5; }
    .tag { display: inline-block; background: #e8f5e9; color: #2d6a4f; padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.8rem; margin-bottom: 0.5rem; }
    .harga { font-size: 1.2rem; font-weight: bold; color: #f4a261; margin-top: 0.5rem; }
    footer { background: #1a3a2a; color: #adc; text-align: center; padding: 2rem; margin-top: 4rem; }
    .view-all { text-align: center; margin-top: 2rem; }
    .view-all a { color: #2d6a4f; font-weight: bold; text-decoration: none; border: 2px solid #2d6a4f; padding: 0.5rem 1.5rem; border-radius: 8px; }
  </style>
</head>
<body>
  <header>
    <h1>🕌 An Namiroh</h1>
    <nav>
      <a href="/">Beranda</a>
      <a href="/produk">Paket</a>
      <a href="/blog">Blog</a>
    </nav>
  </header>

  <div class="hero">
    <h2>Perjalanan Ibadah yang Berkesan</h2>
    <p>Kami hadir untuk memudahkan perjalanan umroh dan haji Anda</p>
    <a href="/produk" class="btn">Lihat Paket Kami</a>
  </div>

  <div class="section">
    <h2>Paket Unggulan</h2>
    <div class="grid">
      {produks.map(p => (
        <div class="card">
          <div class="card-body">
            <span class="tag">{p.data.kategori}</span>
            <h3>{p.data.nama}</h3>
            <p class="harga">{p.data.harga}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="view-all"><a href="/produk">Lihat Semua Paket →</a></div>
  </div>

  <div class="section" style="background:#f9f9f9; max-width:100%; padding: 4rem 2rem;">
    <div style="max-width:1100px; margin:0 auto;">
      <h2>Artikel Terbaru</h2>
      <div class="grid">
        {blogs.map(b => (
          <div class="card">
            <div class="card-body">
              <h3><a href={`/blog/${b.slug}`} style="color:#1a3a2a; text-decoration:none;">{b.data.judul}</a></h3>
              <p>{b.data.ringkasan}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="view-all"><a href="/blog">Lihat Semua Artikel →</a></div>
    </div>
  </div>

  <footer>
    <p>© 2026 An Namiroh. Melayani dengan sepenuh hati.</p>
  </footer>
</body>
</html>
